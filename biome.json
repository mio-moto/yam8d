{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!!**/node_modules",
            "!!**/dist",
            "!!packages/m8-sdk/types",
            "!!**/.git"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "lineWidth": 150,
        "indentWidth": 4,
        "useEditorconfig": false
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": "off"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "indentStyle": "space",
            "semicolons": "asNeeded"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["public/**/*.svg"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noImportantStyles": "off"
                    },
                    "correctness": {
                        "noUnknownProperty": "off"
                    }
                }
            }
        },
        {
            "includes": ["public/cont8xt.html"],
            "linter": {
                "rules": {
                    "complexity": {
                        "useOptionalChain": "off"
                    }
                }
            }
        },
        {
            "includes": ["src/features/rendering/ShaderCodeEditor.tsx"],
            "linter": {
                "rules": {
                    "style": {
                        "useTemplate": "off"
                    }
                }
            }
        }
    ]
}